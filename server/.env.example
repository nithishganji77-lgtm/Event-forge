NODE_ENV=development
# 5000/5001 are commonly taken on macOS (AirPlay Receiver) — 4000 avoids that conflict.
PORT=4000

# MongoDB — local dev by default; swap to an Atlas SRV URI in production with no code changes.
MONGODB_URI=mongodb://localhost:27017/eventforge

CLIENT_URL=http://localhost:5173
SERVER_BASE_URL=http://localhost:4000

# Generate strong random values for these, e.g. `openssl rand -hex 32`. Must differ from each other.
JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
REFRESH_TOKEN_TTL_MS=604800000

# Only needed cross-subdomain in production (e.g. .eventforge.com); leave blank for local dev.
COOKIE_DOMAIN=

# Optional — event cover images fall back to local disk storage (server/uploads) when unset.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
STORAGE_LOCAL_DIR=./uploads

# Email delivery priority: Resend (if RESEND_API_KEY set) -> SMTP (if SMTP_* set) -> console log.
# Resend: sandbox mode (no verified domain) can only deliver to the address that owns the API key.
RESEND_API_KEY=
RESEND_FROM_EMAIL=EventForge <onboarding@resend.dev>

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=EventForge <no-reply@eventforge.dev>

# Optional — the Google button is hidden on the frontend and /auth/google is disabled when unset.
# Client ID only, from Google Cloud Console > APIs & Services > Credentials (no client secret
# needed). Must match VITE_GOOGLE_CLIENT_ID in client/.env exactly (same value, both public).
GOOGLE_CLIENT_ID=
