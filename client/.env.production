# Used by `npm run build` only (`npm run dev` keeps using .env, i.e. your local API). Both values are
# public: they end up in the browser bundle anyway, so this file is committed and any frontend host
# builds without extra setup.
#
# Same-origin on purpose: vercel.json proxies /api/* to the Render API, so the browser only ever talks
# to the frontend's own domain. That makes the auth cookies first-party, which Safari (and every
# iPhone browser) requires; a cross-site API would have them blocked as third-party cookies.
VITE_API_BASE_URL=/api/v1

# Same Client ID as the server's GOOGLE_CLIENT_ID. The deployed frontend's origin must also be added
# to this OAuth client's "Authorized JavaScript origins" in Google Cloud Console.
VITE_GOOGLE_CLIENT_ID=252347458085-inr05mrdpaap81b0brplvds984q8plvt.apps.googleusercontent.com
